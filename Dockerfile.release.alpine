# luafan2/Dockerfile.release.alpine
# ---------------------------------------------------------------------------
# Release runtime image for LuaFan v2 on Alpine 3.20 (musl libc, LTS).
#
# Same two-stage layout as Dockerfile.release.ubuntu. Alpine has some
# musl-specific quirks that v2 already handles (see luafan2 sources):
#   - setprogname() is Linux-glibc-only; posix.c uses a nil-returning
#     stub on musl (see src/sys/posix.c, gated by FAN_PLATFORM_LINUX
#     + a runtime `__progname` symbol probe).
#   - sysconf(_SC_OPEN_MAX) replaces getdtablesize(2) (v1 macro path)
#     because musl doesn't expose the latter.
#   - fan.tls / fan.http/httpd use system OpenSSL 3.x (alpine 3.20
#     ships openssl 3.3.x — same major line as ubuntu 22.04's openssl
#     3.0.x; both go through the same OpenSSL 3-compatible shim in
#     src/net/tls.c).
#
# Alpine coverage status (as of M14.E on arm1): normal build 508/508
# green under musl aarch64. ASan not run on musl (LSan has known
# false-positives on musl 1.2.5 with global-tls destructors — CI only
# runs ASan on ubuntu glibc).
#
# Why not alpine:3.16? EOL 2024-05, main apk repo missing several
# runtime packages by 2025+ (libssl1.1 in particular was removed).
# Alpine 3.20 is the current LTS and stays supported until 2026-04.
#
# Build:  docker build -f Dockerfile.release.alpine -t luafan/luafan2-alpine:local .
# Run:    docker run --rm -it -v $PWD:/w -w /w luafan/luafan2-alpine:local your_script.lua
# ---------------------------------------------------------------------------

# ==================================================================
# Stage 1: builder
# ==================================================================
FROM alpine:3.20.10 AS builder

# apk (not apt). Alpine package names diverge from Ubuntu:
#   lua5.3 / lua5.3-dev  (ships liblua-5.3.so.0 and headers)
#   libevent-dev         (2.1.x static + dynamic)
#   openssl-dev          (openssl 3.3.x on alpine 3.20 — same major
#                         line as ubuntu 22.04, exercised green by CI)
#   sqlite-dev
#   mariadb-connector-c-dev  (libmariadb; matches Ubuntu's libmariadb3)
#   curl-dev             (libcurl 8.x on 3.20)
#   zlib-dev
#   libbsd-dev           (musl doesn't ship <sys/queue.h>; libbsd-dev
#                         provides the BSD compat header, used by
#                         src/net/httpd.c for TAILQ_* macros. Headers
#                         only — the macros are compile-time, no
#                         runtime linkage against libbsd is required.)
RUN apk add --no-cache \
        build-base \
        cmake \
        pkgconfig \
        ca-certificates \
        lua5.3-dev \
        libevent-dev \
        openssl-dev \
        zlib-dev \
        sqlite-dev \
        mariadb-connector-c-dev \
        curl-dev \
        libbsd-dev

WORKDIR /src
COPY . /src

# Alpine's lua5.3-dev installs pkg-config metadata under lua5.3.pc;
# CMake's find_library(NAMES lua5.3 lua-5.3 lua) picks it up without
# extra hints. Verify explicitly if issues arise:
#   cmake --debug-find -S /src -B /src/build ...
RUN cmake -S /src -B /src/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DFAN_WITH_OPENSSL=ON \
        -DFAN_WITH_ZLIB=ON \
        -DFAN_WITH_CURL=ON \
        -DFAN_WITH_SQLITE3=ON \
        -DFAN_WITH_MARIADB=ON \
    && cmake --build /src/build -j"$(nproc)" --target fan \
    && strip /src/build/fan /src/build/fan.so

RUN test -x /src/build/fan \
 && /src/build/fan -v

# ==================================================================
# Stage 2: runtime
# ==================================================================
FROM alpine:3.20.10 AS runtime

# Runtime-only apk packages. Package names WITHOUT -dev suffix, and
# note that on Alpine several .so's ship in the base package rather
# than a split -runtime one (unlike Debian/Ubuntu).
#
# libevent: alpine 3.20's libevent-2.1.12-r7 main package already
# includes libevent_openssl-2.1.so.7 and libevent_pthreads-2.1.so.7
# (verified via `apk info -L libevent` on aarch64). The separate
# `libevent-openssl` and `libevent-pthreads` subpackages that existed
# on alpine 3.16 were merged back into the main package sometime
# between 3.16 and 3.20. Listing the (now non-existent) subpackages
# in `apk add` fails with "no such package" — regression witnessed
# on both amd64 and arm64 in CI, root cause of the 3-second alpine
# build failure. Just install `libevent` and everything is there.
#
# openssl 3.x on alpine 3.20 ships libssl.so.3 + libcrypto.so.3 via
# `libssl3` + `libcrypto3` — the two libraries `ldd fan` needs at
# load time.
RUN apk add --no-cache \
        lua5.3 \
        libevent \
        libssl3 \
        libcrypto3 \
        zlib \
        sqlite-libs \
        mariadb-connector-c \
        libcurl \
        ca-certificates

# M15 dual-form delivery: `fan` is a thin executable that dlopen()s
# `fan.so` (from the same directory as the running binary — see
# src/main.c). Both files MUST land side-by-side.
COPY --from=builder /src/build/fan     /usr/local/bin/fan
COPY --from=builder /src/build/fan.so  /usr/local/bin/fan.so
COPY --from=builder /src/lua/          /usr/local/share/lua/5.3/
# M24: ship the application framework as top-level runtime files for
# downstream consumers. Do not create a `webase/` directory in the image:
# flatten the historical source directory into /root/.
COPY --from=builder /src/webase/       /root/

# Make the flattened application modules visible both to the build-time
# smoke test and to the default runtime command.
ENV LUA_PATH="/root/?.lua;/root/?/init.lua;/usr/local/share/lua/5.3/?.lua;/usr/local/share/lua/5.3/?/init.lua;;"

# Same smoke test as the Ubuntu image, including the top-level application
# resources consumed by downstream images. Loading the application modules
# also proves LUA_PATH and mime.types resolution without starting the server.
RUN fan -v \
 && test -f /root/mime.types \
 && test -f /root/core.lua \
 && test -f /root/route.lua \
 && test -f /root/service.lua \
 && test -f /root/webfile.lua \
 && test -f /root/web/index.html \
 && test -d /root/config.d \
 && fan -e "for _, m in ipairs({'fan','fan.compat','fan.utils','fan.log','fan.json','fan.objectbuf','fan.stream','fan.httpd','fan.http','fan.websocket','fan.orm','fan.pool','fan.worker','fan.popen','fan.upnp','fan.reliable_udp','fan.connector','fan.config','config','route','mapping','service','mimetypes','webfile','ctxpool'}) do assert(require(m), m) end print('release image smoke: OK')"

# Default application-image behavior: start the bundled core.lua; passing
# another script overrides CMD while retaining the fan executable entrypoint.
# core.lua resolves config.d, mapping, mime.types, and the default web root
# relative to the application bundle. Start in /root so the bundled service
# is self-contained; callers can still override the working directory with
# `docker run -w ...` when mounting an application.
VOLUME ["/root/config.d"]
WORKDIR /root
ENTRYPOINT ["/usr/local/bin/fan"]
CMD ["/root/core.lua"]
